<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFC"
    tools:context=".activities.PdfViewerActivity">

    <!-- Top Navigation Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnPdfBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#1E293B" />

        <TextView
            android:id="@+id/tvPdfTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-bold"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="Scanned Note"
            android:textColor="#1E293B"
            android:textSize="18sp" />

        <!-- Progress/Confidence Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_ocr_badge"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="✓ OCR Complete"
                android:textColor="#166534"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnPdfMoreOptions"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="More options"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_more"
            app:tint="#475569" />
    </LinearLayout>

    <!-- Main Content Area -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/bottomBar"
        app:layout_constraintTop_toBottomOf="@id/topBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Visual Preview Card for Captured Image -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardImagePreview"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#E2E8F0"
                app:strokeWidth="1dp"
                tools:visibility="visible">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/imgScannedThumbnail"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Scanned image preview"
                        android:scaleType="centerCrop" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#20000000" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|start"
                        android:layout_margin="12dp"
                        android:background="#80000000"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="Original Capture"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Inline Quick Formatting Toolbar -->
            <HorizontalScrollView
                android:id="@+id/formattingBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnFormatBold"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="44dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="6dp"
                        android:padding="0dp"
                        android:text="B"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnFormatItalic"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="44dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="6dp"
                        android:padding="0dp"
                        android:text="I"
                        android:textStyle="italic" />

                    <Button
                        android:id="@+id/btnFormatBullet"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="44dp"
                        android:layout_height="38dp"
                        android:layout_marginEnd="6dp"
                        android:padding="0dp"
                        android:text="•" />

                    <Button
                        android:id="@+id/btnFormatHeading"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="54dp"
                        android:layout_height="38dp"
                        android:padding="0dp"
                        android:text="H1" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Read-Only Formatted Display -->
            <TextView
                android:id="@+id/tvPdfContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:textColor="#334155"
                android:textSize="15sp" />

            <!-- Direct Inline Editor -->
            <EditText
                android:id="@+id/etInlineEditor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="220dp"
                android:background="@drawable/bg_editor_box"
                android:gravity="top|start"
                android:hint="Edit scanned note content..."
                android:lineSpacingExtra="4dp"
                android:padding="14dp"
                android:textColor="#334155"
                android:textColorHint="#94A3B8"
                android:textSize="15sp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- WebView Container for Tables -->
    <WebView
        android:id="@+id/webViewContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/bottomBar"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- Bottom Action Bar with Highlighted Primary Button -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/btnActionDownload"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Download"
                android:textColor="#475569"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnActionShare"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Share"
                android:textColor="#475569"
                android:textSize="13sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActionSaveNotes"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1.4"
            android:backgroundTint="#1B64F2"
            android:fontFamily="sans-serif-medium"
            android:text="Save to Notes"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            app:cornerRadius="12dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>